# Copy to .env.local and fill in the values. Never commit real values.

# Supabase project (publishable key only; no service role / secret key is used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini API (server-side only)
GEMINI_API_KEY=

# Optional, Preview only: set to 1 to allow fault injection (x-demo-fault header / ?fault=).
# Never set in Production (it is also ignored there when VERCEL_ENV=production).
FAULT_INJECTION_ENABLED=
